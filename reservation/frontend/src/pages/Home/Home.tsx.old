                      <span>🏊</span>
                      <span>🍽️</span>
                      <span>📶</span>
                      <span>💆</span>
                    </div>
                    <div className="hotel-price-premium">
                      <span className="price-label-premium">from</span>
                      <span className="price-amount-premium">${hotel.price}</span>
                      <span className="price-unit">/night</span>
                    </div>
                  </div>
                </div>
              </Link>
            ))}
          </div>
        </div>
      </section>

      {/* Quick Actions */}
      <section className="quick-actions-section">
        <div className="container-xl">
          <div className="action-cards-premium">
            <Link to="/reserve" className="action-card-modern primary-gradient">
              <div className="action-icon-premium">🔍</div>
