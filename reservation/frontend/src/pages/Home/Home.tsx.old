        </div>
        
        <div className="hero-content-premium">
          <h1 className="hero-title-xl fade-in">
            Find Your Perfect Stay
          </h1>
          <p className="hero-subtitle-lg fade-in">
            Discover amazing deals on hotels, resorts, and unique stays worldwide
