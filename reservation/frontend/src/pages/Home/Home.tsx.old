import { useState } from 'react';
import { Link } from 'react-router-dom';
import { Button, Input } from '@/components';
import { heroImages, destinationImages, hotelImages } from '@/assets/images';
import type { SearchParams } from '@/types';
import './Home.css';

export const Home = () => {
  const [searchParams, setSearchParams] = useState<SearchParams>({
    destination: '',
    checkin: '',
    checkout: '',
    guests: 1,
  });

  const handleSearch = () => {
    console.log('Searching with params:', searchParams);
  };

  const featuredDestinations = [
    { name: 'Paris', hotels: 1234, image: destinationImages.paris },
    { name: 'Tokyo', hotels: 892, image: destinationImages.tokyo },
    { name: 'Dubai', hotels: 756, image: destinationImages.dubai },
    { name: 'New York', hotels: 1567, image: destinationImages.newYork },
    { name: 'London', hotels: 1098, image: destinationImages.london },
    { name: 'Bali', hotels: 654, image: destinationImages.bali },
  ];

  const featuredHotels = [
    { name: 'Grand Luxury Hotel', location: 'Paris, France', rating: 9.2, price: 299, image: hotelImages.hotel1 },
    { name: 'Ocean View Resort', location: 'Bali, Indonesia', rating: 9.5, price: 189, image: hotelImages.hotel2 },
    { name: 'City Center Plaza', location: 'Tokyo, Japan', rating: 8.8, price: 249, image: hotelImages.hotel3 },
  ];

  return (
    <div className="home-premium">
      {/* Cinematic Hero Section */}
      <section className="hero-cinematic">
        <div className="hero-background">
          <img src={heroImages.main} alt="Luxury Hotel" className="hero-image" />
