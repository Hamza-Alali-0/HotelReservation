                      <span className="rating-score">{hotel.rating}</span>
                      <span className="rating-label">Excellent</span>
                    </div>
                  </div>
                  <p className="hotel-location-premium">📍 {hotel.location}</p>
                  <div className="hotel-footer-premium">
